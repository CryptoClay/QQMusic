# Copy to .env and fill in. Never commit .env.

# --- Paths -------------------------------------------------------------------
# Windows folder with library/, staging/, .trash/, .backups/
MUSIC_ROOT=B:\Music

# Optional Compose profiles: recommendations (NVIDIA GPU), gateway (configured VPS).
# COMPOSE_PROFILES=recommendations,gateway
# Existing installations: scripts/Migrate-QQMusic.ps1 binds the original volumes.
# QQMUSIC_HUB_VOLUME=homemusic_hub-data
# QQMUSIC_NAVIDROME_VOLUME=homemusic_navidrome-data
# QQMUSIC_EMBEDDER_VOLUME=homemusic_embedder-data
# QQMUSIC_MODELS_VOLUME=homemusic_embedder-models

# --- Gateway -----------------------------------------------------------------
VPS_HOST=
VPS_USER=qqmusic-tunnel
# Public URLs used for links/QR and CORS. For a VPS, use its HTTPS addresses.
PUBLIC_MUSIC_URL=http://localhost:4533
PUBLIC_HUB_URL=http://localhost:8081

# --- Navidrome ---------------------------------------------------------------
# Random string; Navidrome encrypts stored user passwords with it. Don't change after first start.
ND_PASSWORDENCRYPTIONKEY=
# Navidrome admin. The Hub uses it for library scans (startScan needs admin rights).
NAVIDROME_ADMIN_USER=admin
NAVIDROME_ADMIN_PASSWORD=

# --- Hub ---------------------------------------------------------------------
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HUB_SECRET_KEY=
LOG_LEVEL=INFO
# Optional Netscape cookies exported for youtube.com; see docs/audio-sources.md.
# Container path, e.g. /music/.youtube-cookies.txt; leave unset for anonymous downloads.
# YTDLP_COOKIES_FILE=/music/.youtube-cookies.txt
# Compose sets YTDLP_POT_BASE_URL=http://youtube-pot:4416 and persistent YTDLP_CACHE_DIR=/data/yt-dlp-cache.
# Outside Compose, point YTDLP_POT_BASE_URL at your local bgutil 2.0.2 server (no public port).
# Invite codes (admin → Пользователи → «Пригласить») are valid this many days by default.
INVITE_DAYS=7
# Sign in with Google: OAuth client id of the Web application type.
# Empty — the app shows no Google button. Not a secret.
GOOGLE_CLIENT_ID=
# Registration by email without an invite: verification code via SMTP;
# Gmail: smtp.gmail.com, 587, the address and an app password (free, ~500 letters a day). Empty host — no such registration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# the sender's address; empty — SMTP_USER
SMTP_FROM=
# at most this many letters in 24 hours (Gmail sends ~500), then registration asks to try tomorrow
EMAIL_DAILY_LIMIT=450

# --- «Микс дня» (docs/mixes.md) ---------------------------------------------------
# Last.fm API key (free: https://www.last.fm/api/account/create): similar tracks/artists, tags for mix names.
# Empty — mixes are built from the other sources.
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
LASTFM_APPLICATION_NAME=
LASTFM_REGISTERED_TO=
# Users' local time: the hour a mix is built at (the containers run in UTC).
TIMEZONE=Europe/Moscow

# --- Embedder (audio vectors on the GPU, docs/mixes.md) ---------------------------
# The Hub calls it inside the compose network. The token is optional (the port is not published).
EMBEDDER_URL=http://embedder:8090
EMBEDDER_TOKEN=

# --- Nextcloud: personal accounts are configured in Settings -> Nextcloud ------
# Optional server allowed for ordinary users (admins can also add a server in the UI).
# NEXTCLOUD_URL=https://cloud.example.com
# Standalone checker credentials below are separate from personal web connections.
# python -m app.providers.nextcloud "Artist - Song" --limit 5 (inside hub/)
# Base server URL (including subpath, if any), not the /remote.php/dav URL.
# NEXTCLOUD_USER=your-nextcloud-user
# NEXTCLOUD_PASSWORD=app-password
# NEXTCLOUD_FOLDER=Music

# --- Optional outbound proxy for catalog hosts (e.g. via the VPS) ----------
# OUTBOUND_PROXY=http://host.docker.internal:3128
# OUTBOUND_PROXY_HOSTS=api.deezer.com

# Public server: use deploy/compose.public.yml with a real DNS name.
# Keep PUBLIC_MODE=false for local HTTP. The public override enables it and supplies the HTTPS origin.
PUBLIC_MODE=false
PUBLIC_LOGIN_LIMIT=10
# QQM_DOMAIN=music.example.com
